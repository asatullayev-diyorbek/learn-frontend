{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://217.149.24.202.sslip.io/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://217.149.24.202.sslip.io/api/:path*/"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
